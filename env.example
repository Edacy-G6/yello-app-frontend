# ============================================
# Configuration Frontend Yello - React + Vite
# ============================================

# ============================================
# Configuration de l'API Backend
# ============================================
VITE_API_BASE_URL=http://localhost:3000

# ============================================
# Configuration Google OAuth
# ============================================
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# ============================================
# Configuration de l'Environnement
# ============================================
VITE_NODE_ENV=development

# ============================================
# Configuration des URLs
# ============================================
VITE_FRONTEND_URL=http://localhost:5173

# ============================================
# Configuration des Services Externes
# ============================================
# RAG API (pour l'IA)
VITE_RAG_API_URL=http://localhost:8086

# ============================================
# Configuration de Debug
# ============================================
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug

# ============================================
# Notes d'Utilisation
# ============================================
# 1. Copiez ce fichier vers .env.local
# 2. Modifiez les valeurs selon votre environnement
# 3. Ne commitez jamais les fichiers .env avec des vraies valeurs
# 4. Les variables VITE_ sont exposées côté client
# 5. Configurez VITE_GOOGLE_CLIENT_ID avec votre Client ID Google
